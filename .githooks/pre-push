#!/bin/sh
# Runs Sparring's tests and the shared-file check before anything is pushed, and stops the
# push when one fails.
#
# The standards tests need nothing but the repository and always run. The unit tests need
# BepInEx.dll from a local BepInEx profile, which is not in the repository; where there is none,
# they are left out with a warning. SPARRING_PROFILE_DIR points at another profile than the
# default Gale one.
#
# Git runs hooks only from a folder it is told about, once per clone:
#   git config core.hooksPath .githooks

root="$(git rev-parse --show-toplevel)"

if ! dotnet test "$root/tests/Sparring.Standards" --nologo --verbosity quiet; then
    echo "pre-push: the standards tests failed, so nothing was pushed" >&2
    exit 1
fi

if ! sh "$root/tools/check-shared.sh"; then
    echo "pre-push: a file shared with the sibling mod differs from its copy, so nothing was pushed" >&2
    exit 1
fi

profile="${SPARRING_PROFILE_DIR:-$APPDATA/com.kesomannen.gale/valheim/profiles/Default}"

if [ ! -f "$profile/BepInEx/core/BepInEx.dll" ]; then
    echo "pre-push: unit tests skipped, there is no BepInEx.dll under $profile" >&2
    exit 0
fi

if ! dotnet test "$root/tests/Sparring.Tests" -p:ProfileDir="$profile" --nologo --verbosity quiet; then
    echo "pre-push: the unit tests failed, so nothing was pushed" >&2
    exit 1
fi
